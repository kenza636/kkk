    Padding(padding: const EdgeInsets.symmetric(horizontal: 34), child: Row(children: [Container(width: 48, height: 48, decoration: BoxDecoration(color: const Color(0xFF3156C8), borderRadius: BorderRadius.circular(12)), child: const Icon(Icons.flight_takeoff_rounded, color: Colors.white)), const SizedBox(width: 13), const Column(crossAxisAlignment: CrossAxisAlignment.start, children: [Text('AirConcept', style: TextStyle(fontSize: 18, fontWeight: FontWeight.w800, color: Color(0xFF17358A))), Text('GRAPHES CONCEPTUELS', style: TextStyle(fontSize: 9, letterSpacing: 1.6, color: Color(0xFF8795B5), fontWeight: FontWeight.w700))])])),
    const SizedBox(height: 32),
    const Padding(padding: EdgeInsets.symmetric(horizontal: 36), child: Align(alignment: Alignment.centerLeft, child: Text('MENU PRINCIPAL', style: TextStyle(fontSize: 9, letterSpacing: 1.5, color: Color(0xFF8795B5), fontWeight: FontWeight.w800)))),
    const SizedBox(height: 10),
    Expanded(child: ListView.builder(padding: const EdgeInsets.symmetric(horizontal: 16), itemCount: labels.length, itemBuilder: (_, i) { final active = i == selected; return Padding(padding: const EdgeInsets.only(bottom: 5), child: InkWell(onTap: () => onSelect(i), borderRadius: BorderRadius.circular(8), child: Container(height: 48, decoration: BoxDecoration(color: active ? const Color(0xFFEEF3FF) : Colors.transparent, borderRadius: BorderRadius.circular(8)), child: Row(children: [AnimatedContainer(duration: const Duration(milliseconds: 180), width: 3, height: active ? 30 : 0, margin: const EdgeInsets.only(right: 10), decoration: const BoxDecoration(color: Color(0xFF3156C8), borderRadius: BorderRadius.horizontal(right: Radius.circular(3)))), Icon(icons[i], size: 21, color: active ? const Color(0xFF3156C8) : const Color(0xFF7B879E)), const SizedBox(width: 13), Text(labels[i], style: TextStyle(fontSize: 14, color: active ? const Color(0xFF3156C8) : const Color(0xFF69758B), fontWeight: active ? FontWeight.w700 : FontWeight.w500))])))); })),
    Container(margin: const EdgeInsets.fromLTRB(16, 0, 16, 22), padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 12), decoration: BoxDecoration(border: Border(top: BorderSide(color: Colors.grey.shade200))), child: Row(children: [Container(width: 38, height: 38, alignment: Alignment.center, decoration: BoxDecoration(color: const Color(0xFF3156C8), borderRadius: BorderRadius.circular(10)), child: const Text('AK', style: TextStyle(color: Colors.white, fontWeight: FontWeight.w800))), const SizedBox(width: 10), const Expanded(child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [Text('Allaoua Kenza', style: TextStyle(fontWeight: FontWeight.w700, fontSize: 13)), Text('Étudiante', style: TextStyle(fontSize: 11, color: Color(0xFF8795B5)))])), const Icon(Icons.logout, size: 18, color: Color(0xFF8795B5))])),
  ]));
}

class Header extends StatelessWidget {
  final String title, subtitle;
  const Header({super.key, required this.title, required this.subtitle});
  @override
  Widget build(BuildContext context) => Padding(padding: const EdgeInsets.fromLTRB(32, 26, 32, 18), child: Row(children: [Expanded(child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [Text(title, style: const TextStyle(fontSize: 24, fontWeight: FontWeight.w800, color: Color(0xFF17243A))), const SizedBox(height: 7), Text(subtitle, style: const TextStyle(fontSize: 13, color: Color(0xFF8795B5))) ])), Container(width: 42, height: 42, alignment: Alignment.center, decoration: BoxDecoration(color: const Color(0xFF3156C8), borderRadius: BorderRadius.circular(10)), child: const Text('AK', style: TextStyle(color: Colors.white, fontWeight: FontWeight.w800))), const SizedBox(width: 10), const Column(crossAxisAlignment: CrossAxisAlignment.start, children: [Text('Allaoua Kenza', style: TextStyle(fontWeight: FontWeight.w700, fontSize: 12)), Text('Étudiante', style: TextStyle(fontSize: 10, color: Color(0xFF8795B5)))])]));
}

class DashboardPage extends StatelessWidget {
  const DashboardPage({super.key});
  @override
  Widget build(BuildContext context) {
    final wide = MediaQuery.sizeOf(context).width > 900;
    return SingleChildScrollView(child: Column(children: [const Header(title: 'Tableau de bord', subtitle: 'Vue d’ensemble de votre espace de modélisation'), Padding(padding: const EdgeInsets.symmetric(horizontal: 32), child: Column(children: [
      Container(width: double.infinity, padding: const EdgeInsets.all(28), decoration: BoxDecoration(color: const Color(0xFF173C82), borderRadius: BorderRadius.circular(14)), child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [Text('ESPACE ACADÉMIQUE', style: TextStyle(fontSize: 9, letterSpacing: 1.6, color: Colors.blue.shade100, fontWeight: FontWeight.w800)), const SizedBox(height: 13), const Text('Bonjour Allaoua Kenza', style: TextStyle(fontSize: 22, color: Colors.white, fontWeight: FontWeight.w800)), const SizedBox(height: 8), Text('Créez et explorez simplement vos graphes conceptuels aéronautiques.', style: TextStyle(fontSize: 12, color: Colors.blue.shade100)), const SizedBox(height: 20), ElevatedButton.icon(onPressed: () {}, style: ElevatedButton.styleFrom(backgroundColor: Colors.white, foregroundColor: const Color(0xFF3156C8), elevation: 0, padding: const EdgeInsets.symmetric(horizontal: 20, vertical: 16)), icon: const Icon(Icons.add), label: const Text('Nouvelle phrase'))])),
      const SizedBox(height: 22),
      GridView.count(crossAxisCount: wide ? 4 : 2, shrinkWrap: true, physics: const NeverScrollableScrollPhysics(), crossAxisSpacing: 16, mainAxisSpacing: 16, childAspectRatio: wide ? 1.85 : 1.35, children: const [StatCard(Icons.layers_outlined, Color(0xFF4777F6), 'Concepts', '128', '+12%'), StatCard(Icons.link, Color(0xFF815CF4), 'Relations', '94', '+8%'), StatCard(Icons.share_outlined, Color(0xFF12A69A), 'Graphes créés', '36', '+5'), StatCard(Icons.call_split, Color(0xFFE88A48), 'Projections', '21', '87%')]),
      const SizedBox(height: 22),
      Container(padding: const EdgeInsets.all(24), width: double.infinity, decoration: BoxDecoration(color: Colors.white, border: Border.all(color: const Color(0xFFE4E9F2)), borderRadius: BorderRadius.circular(12)), child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [const Text('DERNIÈRE MODÉLISATION', style: TextStyle(fontSize: 9, letterSpacing: 1.5, color: Color(0xFF8795B5), fontWeight: FontWeight.w800)), const SizedBox(height: 7), const Row(children: [Expanded(child: Text('Graphe conceptuel récent', style: TextStyle(fontSize: 16, fontWeight: FontWeight.w800))), Text('Voir le graphe', style: TextStyle(color: Color(0xFF3156C8), fontWeight: FontWeight.w700, fontSize: 12)), Icon(Icons.arrow_forward, size: 16, color: Color(0xFF3156C8))]), const SizedBox(height: 18), Container(height: 300, decoration: BoxDecoration(color: const Color(0xFFFDFEFF), border: Border.all(color: const Color(0xFFE7EBF3)), borderRadius: BorderRadius.circular(12)), child: const GraphCanvas())])
    ]))]));
  }
}

class StatCard extends StatelessWidget {
