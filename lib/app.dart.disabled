}

class GraphPage extends StatelessWidget {
  const GraphPage({super.key});
  @override
  Widget build(BuildContext context) => SingleChildScrollView(child: Column(children: [const Header(title: 'Graphes conceptuels', subtitle: 'Transformez une phrase en représentation conceptuelle'), Padding(padding: const EdgeInsets.symmetric(horizontal: 32), child: Column(children: [
    Container(padding: const EdgeInsets.all(18), decoration: BoxDecoration(color: Colors.white, border: Border.all(color: const Color(0xFFE4E9F2)), borderRadius: BorderRadius.circular(12)), child: Row(children: [const Text('1', style: TextStyle(color: Color(0xFF3156C8), fontWeight: FontWeight.w800)), const SizedBox(width: 12), const Expanded(child: Text('Le passager voyage dans un avion vers Paris.', style: TextStyle(fontSize: 12))), ElevatedButton.icon(onPressed: () {}, style: ElevatedButton.styleFrom(backgroundColor: const Color(0xFF3156C8), foregroundColor: Colors.white), icon: const Icon(Icons.auto_awesome, size: 18), label: const Text('Générer le graphe'))]),
    const SizedBox(height: 18),
