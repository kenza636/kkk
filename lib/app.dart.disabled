// Version corrigée du projet AirConcept.
import 'package:flutter/material.dart';

void main() {
  runApp(const AirConceptApp());
}

class AirConceptApp extends StatelessWidget {
  const AirConceptApp({super.key});
  @override
  Widget build(BuildContext context) => MaterialApp(
    debugShowCheckedModeBanner: false,
    title: 'AirConcept',
    theme: ThemeData(useMaterial3: true, scaffoldBackgroundColor: const Color(0xFFF5F7FB), colorScheme: ColorScheme.fromSeed(seedColor: const Color(0xFF3156C8))),
    home: const Shell(),
  );
}

class Shell extends StatefulWidget {
  const Shell({super.key});
  @override
  State<Shell> createState() => _ShellState();
}

class _ShellState extends State<Shell> {
  int selected = 0;
  final labels = const ['Tableau de bord', 'Phrases', 'Graphes conceptuels', 'Projection', 'Généralisation', 'Spécialisation', 'Base de données'];
  final icons = const [Icons.home_outlined, Icons.description_outlined, Icons.share_outlined, Icons.alt_route, Icons.call_split, Icons.account_tree_outlined, Icons.storage_outlined];

  @override
  Widget build(BuildContext context) {
    final compact = MediaQuery.sizeOf(context).width < 980;
    final pages = [const DashboardPage(), const PhrasesPage(), const GraphPage(), _simple('Projection'), _simple('Généralisation'), _simple('Spécialisation'), _simple('Base de données')];
    return Scaffold(body: Row(children: [
      if (!compact) Sidebar(labels: labels, icons: icons, selected: selected, onSelect: (i) => setState(() => selected = i)),
      Expanded(child: Column(children: [
        if (compact) AppTopBar(labels: labels, onSelect: (i) => setState(() => selected = i)),
        Expanded(child: AnimatedSwitcher(duration: const Duration(milliseconds: 180), child: pages[selected])),
      ])),
    ]));
  }

  Widget _simple(String title) => Column(children: [Header(title: title, subtitle: 'Module connecté à votre espace AirConcept'), const Expanded(child: Center(child: Text('Interface prête à être configurée', style: TextStyle(color: Color(0xFF8795B5)))))]);
}

class AppTopBar extends StatelessWidget {
  final List<String> labels;
  final ValueChanged<int> onSelect;
  const AppTopBar({super.key, required this.labels, required this.onSelect});
  @override
  Widget build(BuildContext context) => Container(height: 64, padding: const EdgeInsets.symmetric(horizontal: 16), color: Colors.white, child: Row(children: [const Icon(Icons.flight_takeoff_rounded, color: Color(0xFF3156C8)), const SizedBox(width: 10), const Text('AirConcept', style: TextStyle(fontWeight: FontWeight.w800, color: Color(0xFF17358A))), const Spacer(), PopupMenuButton<int>(onSelected: onSelect, itemBuilder: (_) => [for (var i = 0; i < labels.length; i++) PopupMenuItem(value: i, child: Text(labels[i]))])]));
}

