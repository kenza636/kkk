class GraphCanvas extends StatelessWidget {
  const GraphCanvas({super.key});
  @override
  Widget build(BuildContext context) => CustomPaint(painter: GraphPainter(), child: const SizedBox.expand());
}

class GraphPainter extends CustomPainter {
  @override
  void paint(Canvas canvas, Size size) {
    final line = Paint()..color = const Color(0xFFB4BDD3)..strokeWidth = 1.5..style = PaintingStyle.stroke;
    final pass = Offset(size.width * .20, size.height * .43); final vol = Offset(size.width * .44, size.height * .20); final aircraft = Offset(size.width * .44, size.height * .68); final airport = Offset(size.width * .72, size.height * .43); final city = Offset(size.width * .90, size.height * .43);
    canvas.drawLine(pass, vol, line); canvas.drawLine(pass, aircraft, line); canvas.drawLine(vol, airport, line); canvas.drawLine(aircraft, airport, line); canvas.drawLine(airport, city, line);
    void node(Offset p, String top, String bottom, Color border) { final r = RRect.fromRectAndRadius(Rect.fromCenter(center: p, width: 132, height: 58), const Radius.circular(8)); canvas.drawRRect(r, Paint()..color = Colors.white); canvas.drawRRect(r, Paint()..color = border..strokeWidth = 1.6..style = PaintingStyle.stroke); final a = TextPainter(text: TextSpan(text: top, style: const TextStyle(fontSize: 7, letterSpacing: 1, color: Color(0xFF8795B5), fontWeight: FontWeight.w800)), textDirection: TextDirection.ltr)..layout(); final b = TextPainter(text: TextSpan(text: bottom, style: const TextStyle(fontSize: 11, fontWeight: FontWeight.w800, color: Color(0xFF17243A))), textDirection: TextDirection.ltr)..layout(); a.paint(canvas, Offset(p.dx - a.width / 2, p.dy - 18)); b.paint(canvas, Offset(p.dx - b.width / 2, p.dy - 2)); }
    node(pass, 'PERSONNE', 'Passager', const Color(0xFF815CF4)); node(vol, 'VOL', 'AF 123', const Color(0xFF4777F6)); node(aircraft, 'AÉRONEF', 'Airbus A320', const Color(0xFF4777F6)); node(airport, 'AÉROPORT', 'Paris CDG', const Color(0xFF12A69A)); node(city, 'VILLE', 'Paris', const Color(0xFFE88A48));
  }
  @override bool shouldRepaint(covariant CustomPainter oldDelegate) => false;
}
